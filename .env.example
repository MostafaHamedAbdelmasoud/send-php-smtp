# send-mail.php's own .env: copy to api/.env, and upload it with send-mail.php and .htaccess. See EMAIL.md.
# No SMTP settings here: each site sends its own, encrypted with this key.

# The fixed encryption key: the same value goes in every site's .env (make it once with: npm run mail:key)
MAIL_ENCRYPTION_KEY=

# Sites allowed to call the email API from a browser (comma-separated, no trailing slash). localhost is always allowed.
ALLOWED_ORIGINS=https://maryamandmahmoud.com,https://www.maryamandmahmoud.com
