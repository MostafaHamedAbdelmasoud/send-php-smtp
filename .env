# send-mail.php's own .env. Upload it together with send-mail.php and .htaccess to the mail server.
# No SMTP settings here: each site sends its own, encrypted. See EMAIL.md.
#
# The fixed encryption key: the same value goes in every site's .env. Never change it on its own, or every site
# built with the old key stops sending until it's rebuilt with the new one.
MAIL_ENCRYPTION_KEY=QM1mND8WQ5vPjhUmc+nVvDxZ9nfesQ664giy0CR0qSg=

# Sites allowed to call the email API from a browser (comma-separated, no trailing slash). localhost is always allowed.
ALLOWED_ORIGINS=https://maryamandmahmoud.com,https://www.maryamandmahmoud.com,https://khaledandshorouk.vowlyeg.com,https://www.khaledandshorouk.vowlyeg.com
